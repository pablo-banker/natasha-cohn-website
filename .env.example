# ---------------------------------------------------------------------------
# Celebrante Natasha Cohn — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ---------------------------------------------------------------------------

# --- Formulário de contato (Google Forms) ----------------------------------
# O site tem o próprio formulário; por baixo dos panos, as respostas são
# postadas em um Google Form (caem na planilha do Google Forms).
#
# 1. Crie um Google Form com um campo para cada informação (nome do casal,
#    e-mail, WhatsApp, data, cidade e local, tipo de celebração, convidados,
#    idioma, como conheceu, mensagem). Deixe os campos como NÃO obrigatórios
#    (o site já valida o que é necessário).
#
# 2. URL de envio: troque "/viewform" por "/formResponse". Para ESTE site:
#    https://docs.google.com/forms/d/e/1FAIpQLSdRjBaW3c5vMmP2mYrjZE3vuaWuO5IwAA5zEulE8pNb077cbw/formResponse
#    Deixe VAZIO no dev/local (não envia); preencha SÓ em produção (host).
GOOGLE_FORM_URL=
#
# 3. IDs dos campos (entry.XXXX) — mapeamento real deste formulário.
#    "date" usa a pergunta de data (o site divide em ano/mês/dia). O idioma
#    "Outro" é enviado pelo mecanismo de "outra opção" (com o texto livre).
GOOGLE_FORM_ENTRIES={"names":"entry.1572850055","email":"entry.1407587985","whatsapp":"entry.604813447","date":"entry.1092293591","location":"entry.485220391","celebrationType":"entry.1989020426","guests":"entry.277374452","language":"entry.86295847","referral":"entry.39760906","message":"entry.1041521408"}
#
# Sem GOOGLE_FORM_URL, o formulário funciona em modo desenvolvimento
# (não envia nada, apenas confirma).

# Limite de envios por IP a cada 10 minutos (anti-spam). Padrão: 3.
CONTACT_RATE_LIMIT=3

# --- Propostas comerciais (Google Apps Script) -----------------------------
# As páginas /proposta-* buscam os dados do casal (nome, idioma e, futuramente,
# data/local/investimento) por ID. A planilha NÃO é pública: um Apps Script
# publicado como web app devolve o JSON. Cole aqui a URL que termina em /exec.
#
# Contrato: GET <URL>?id=<id>
#   → {"success":true,"data":{"casal":"...","idioma":"..."}}
# Use o parâmetro ?id= — o formato de path /exec/{id} exige login e não serve.
PROPOSAL_SHEET_URL=
